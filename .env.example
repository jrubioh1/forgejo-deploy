# ==============================================================================
# FORGEJO & POSTGRESQL - CONFIGURACIÓN DEL ENTORNO GENTOO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MODO DE BASE DE DATOS (Local vs Remoto)
# ------------------------------------------------------------------------------
# 'local'  -> Levanta el contenedor local de PostgreSQL 18 definido en compose.yaml
# 'remote' -> Conecta a un servidor PostgreSQL externo (directo o vía túnel SSH)
DB_MODE=local

# Perfiles de Compose activos ('local-db' activa el contenedor de PostgreSQL local)
# Si DB_MODE=remote, deja esta variable vacía: COMPOSE_PROFILES=
COMPOSE_PROFILES=local-db

# Parámetros de conexión a la Base de Datos
# Si DB_MODE=local, FORGEJO_DB_HOST debe ser 'db:5432'
# Si DB_MODE=remote por túnel SSH, debe ser '127.0.0.1:5432'
# Si DB_MODE=remote por red directa, debe ser 'IP_O_HOST_REMOTO:5432'
FORGEJO_DB_TYPE=postgres
FORGEJO_DB_HOST=db:5432
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=CambiaEstaClavePorUnaSeguraEnProduccion123!
PGDATA=/var/lib/postgresql/data/pgdata

# Enlace de red y puerto en el host para PostgreSQL local
# Permite cambiar a 5433 si el puerto 5432 ya está ocupado en el host
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL TÚNEL SSH (Solo si DB_MODE=remote y requiere túnel)
# ------------------------------------------------------------------------------
SSH_TUNNEL_ENABLED=false
SSH_TUNNEL_BIND_IP=0.0.0.0
SSH_TUNNEL_USER=root
SSH_TUNNEL_HOST=servidor-bd.remoto.com
SSH_TUNNEL_PORT=22
SSH_TUNNEL_KEY=/root/.ssh/id_ed25519
SSH_TUNNEL_REMOTE_DB_HOST=127.0.0.1
SSH_TUNNEL_REMOTE_DB_PORT=5432
SSH_TUNNEL_LOCAL_PORT=5432

# ------------------------------------------------------------------------------
# 3. ACCESO WEB Y RED (Modo Apache vs Modo Directo)
# ------------------------------------------------------------------------------
# Si usas Apache como Reverse Proxy en este mismo servidor:
# FORGEJO_BIND_IP=127.0.0.1  (Solo escucha localmente, Apache gestiona el tráfico)
# Si usas Acceso Directo por puerto (como hacía GitBucket):
# FORGEJO_BIND_IP=0.0.0.0    (Escucha en todas las interfaces de red)
FORGEJO_BIND_IP=0.0.0.0
FORGEJO_HTTP_PORT=3000

# Puerto SSH dedicado para clonado Git (evita conflicto con el sshd de Gentoo)
FORGEJO_SSH_BIND_IP=0.0.0.0
FORGEJO_SSH_PORT=2222

# Dominio y URL pública de Forgejo
# Si usas subdominio en Apache: FORGEJO_ROOT_URL=https://git.tudominio.com/
# Si usas acceso directo:        FORGEJO_ROOT_URL=http://tu-servidor:3000/
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3000/

# ------------------------------------------------------------------------------
# 4. IDENTIFICADORES DE USUARIO Y PODMAN (Root / Rootless)
# ------------------------------------------------------------------------------
# Si se ejecuta como root en Gentoo: USER_UID=0, USER_GID=0, USERNS_MODE=keep-id
# Si se ejecuta como usuario no root: id -u / id -g
USER_UID=0
USER_GID=0
USERNS_MODE=keep-id

# ------------------------------------------------------------------------------
# 5. VERSIÓN DE LA IMAGEN DE FORGEJO (100% Rootless Obligatorio)
# ------------------------------------------------------------------------------
# Tag de la imagen de Forgejo. SIEMPRE debe terminar en -rootless.
# Ejemplos: 17.0.2-rootless (fijado), 17-rootless (canal continuo)
FORGEJO_VERSION=17-rootless
